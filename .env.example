# =============================================
# Chore Me - Environment Variables
# Copy this file to .env and fill in values
# =============================================

# REQUIRED: App security key (generate a long random string)
SECRET_KEY=your-long-random-secret-key-here

# REQUIRED: Database (MySQL for production on SiteGround)
# Format: mysql+pymysql://USERNAME:PASSWORD@localhost/DATABASE_NAME
DATABASE_URL=mysql+pymysql://dbuser:dbpassword@localhost/choremenow_db

# REQUIRED: Google Gemini AI
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Stripe payments
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_FAMILY=price_your_family_plan_id
STRIPE_PRICE_PREMIUM=price_your_premium_plan_id

# OPTIONAL: Email (for password reset)
# SiteGround SMTP settings
MAIL_SERVER=mail.choremenow.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=support@choremenow.com
MAIL_PASSWORD=your_email_password_here
MAIL_DEFAULT_SENDER=support@choremenow.com
