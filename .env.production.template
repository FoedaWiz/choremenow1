# Copy this to .env on SiteGround and fill in values

SECRET_KEY=GENERATE_A_NEW_LONG_RANDOM_KEY_HERE
FLASK_ENV=production

# Database (SiteGround MySQL - update this)
DATABASE_URL=mysql+pymysql://DB_USER:DB_PASS@localhost/DB_NAME

# Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Stripe (switch to live keys when ready)
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Email (SiteGround SMTP)
MAIL_SERVER=smtp.siteground.net
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=hello@chormenow.com
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD
MAIL_DEFAULT_SENDER=hello@chormenow.com
